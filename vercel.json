{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "generator/**",
          "libraries/**",
          "config/**",
          "assets/**",
          "web/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "app.py" }]
}
